# Copy to .env and edit. Never commit .env.

NODE_ENV=development
PORT=4000
HOST=0.0.0.0

# SQLite file (created automatically). Back it up regularly: `npm run backup`
DB_PATH=./data/seedsure.db

# REQUIRED in production: 32+ random characters.
# Generate one:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# First admin account, created on first start if no admin exists yet.
# Use a strong password (10+ characters) and change it after first login.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=ChangeMe!12345
ADMIN_NAME=Seed Admin

# Insert the 5 sample batches when the batches table is empty (1 = yes, 0 = no).
# Defaults to 1 in development and 0 in production.
SEED_SAMPLE_DATA=1

# Public address printed inside QR codes, e.g. https://seedsure.yourdomain.com
# QR labels must point at your PUBLIC site, not localhost.
PUBLIC_URL=http://localhost:5173

# Set to 1 when running behind a reverse proxy (nginx, Caddy, Render, Railway...)
# so client IPs are read from X-Forwarded-For.
TRUST_PROXY=0

# Cookies are marked Secure automatically in production. Override with 0/1 if needed.
# COOKIE_SECURE=1
